---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts, getTagSummary, slugifyTag, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getTagSummary(posts);

  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.some((item) => slugifyTag(item) === slug)),
    },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`${tag} | Build Notes`}
  description={`Posts filed under ${tag}.`}
>
  <section class="section">
    <p class="eyebrow">Tag</p>
    <h1>{tag}</h1>
    <p class="section__lead">Posts connected to this topic.</p>

    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</BaseLayout>
